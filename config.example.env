# Twitch Bot Configuration
# Copy this file to .env and fill in your values

# Your Twitch bot's OAuth token (get one at https://twitchtokengenerator.com)
TWITCH_TOKEN=oauth:your_token_here

# The bot's Twitch username
TWITCH_BOT_USERNAME=your_bot_username

# The channel to monitor (without #)
TWITCH_CHANNEL=target_channel_name

# How often to capture frames (in seconds). Lower = more CPU, higher = might miss deaths.
CAPTURE_INTERVAL=2.0

# Detection confidence threshold (0.0 - 1.0). Higher = fewer false positives.
DETECTION_THRESHOLD=0.80

# The game to detect deaths for. Options: elden_ring, dark_souls_3, sekiro, hollow_knight, celeste, generic
# Use "auto" to attempt automatic game detection, or comma-separate multiple: elden_ring,dark_souls_3
GAME_PROFILE=elden_ring

# Cooldown in seconds between death detections (prevents counting the same death twice)
DEATH_COOLDOWN=15

# Stream quality for capture (best, 1080p60, 1080p, 720p60, 720p, 480p, worst)
STREAM_QUALITY=720p

# =============================================================================
# Twitch Death Counter Bot - Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp config.example.env .env
#
# See SETUP.md for detailed instructions on getting your Twitch credentials.

# --- Twitch Credentials (Required) ---

# Your Twitch bot's OAuth token.
# Get one at: https://twitchtokengenerator.com
# Required scopes: chat:read, chat:edit
TWITCH_TOKEN=oauth:your_token_here

# The Twitch channel to join and monitor (without #)
TWITCH_CHANNEL=target_channel_name

# --- Twitch API (Optional - enables auto game detection) ---

# Your Twitch application's Client ID.
# Create an app at: https://dev.twitch.tv/console/apps
# Only needed if you set GAME_PROFILE=auto
TWITCH_CLIENT_ID=

# --- Game Detection ---

# Which game profile to use for death detection.
# Options: elden_ring, dark_souls_2, dark_souls_3, sekiro, hollow_knight, celeste, generic
# Set to "auto" to auto-detect from the Twitch category (requires TWITCH_CLIENT_ID)
GAME_PROFILE=elden_ring

# --- Detection Tuning ---

# Target frames per second for stream capture. Higher = faster detection but more CPU.
# Options: 5 (low CPU), 10, 15 (recommended), 24, 30 (full rate)
TARGET_FPS=15

# Detection confidence threshold (0.0 - 1.0). Higher = fewer false positives.
DETECTION_THRESHOLD=0.80

# Cooldown in seconds between death detections (prevents counting the same death twice)
DEATH_COOLDOWN=15

# Stream quality for capture (best, 1080p60, 1080p, 720p60, 720p, 480p, worst)
STREAM_QUALITY=720p

# --- Bot Behavior ---

# Command prefix (default: !)
COMMAND_PREFIX=!

# Whether the bot automatically announces deaths in chat (true/false)
# Can also be toggled at runtime with !toggleannounce
ANNOUNCE_DEATHS=true

# --- Clip Recording (Death Compilation) ---

# Set to true to save a short video clip around each death
CLIP_ENABLED=true

# Seconds of footage to keep BEFORE the death
CLIP_PRE_DEATH_SECONDS=3.0

# Seconds of footage to capture AFTER the death
CLIP_POST_DEATH_SECONDS=2.0

# Playback FPS for saved clips (frames are duplicated to fill the timeline)
CLIP_OUTPUT_FPS=10.0

# Directory to save clips (default: clips/ in project root)
# CLIP_OUTPUT_DIR=clips

# --- Web Testing GUI ---

# Port for the web testing GUI (run with MODE=web or python web/app.py)
WEB_PORT=4444

# Set to true for Flask debug mode (auto-reload on code changes)
WEB_DEBUG=false

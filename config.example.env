# =============================================================================
# Twitch Death Counter Bot - Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp config.example.env .env
#
# This bot runs as a web app. You configure which channel to monitor and
# which game profile to use from the web UI at http://localhost:4444/bot.
#
# The values below are defaults that pre-fill the web UI forms. The actual
# channel, profile, and token used for each detection job are set in the UI.
#
# See SETUP.md for detailed setup instructions.

# --- Twitch Credentials ---

# Your Twitch bot's OAuth token (pre-fills the web UI token field).
# Get one at: https://twitchtokengenerator.com
# Required scopes: chat:read, chat:edit
TWITCH_TOKEN=oauth:your_token_here

# Default channel to monitor (pre-fills the web UI channel field).
# You can change this per-job in the web UI.
TWITCH_CHANNEL=target_channel_name

# --- Twitch API (Optional - enables auto game detection) ---

# Your Twitch application's Client ID.
# Create an app at: https://dev.twitch.tv/console/apps
# Enables the "Detect Game" button in the web UI.
TWITCH_CLIENT_ID=

# --- Default Detection Settings ---
# These are the defaults shown in the web UI. Each job can override them.

# Default game profile for death detection.
# Options: elden_ring, dark_souls_2, dark_souls_3, sekiro, hollow_knight, celeste, generic
GAME_PROFILE=elden_ring

# Target frames per second for stream capture (5-30). Higher = faster detection, more CPU.
TARGET_FPS=15

# Detection confidence threshold (0.0 - 1.0). Higher = fewer false positives.
DETECTION_THRESHOLD=0.80

# Seconds between death detections (prevents counting the same death twice).
DEATH_COOLDOWN=15

# Stream quality for capture (best, 1080p60, 1080p, 720p60, 720p, 480p, worst).
STREAM_QUALITY=720p

# --- Bot Behavior ---

# Command prefix for chat commands (default: !)
COMMAND_PREFIX=!

# Whether the bot automatically announces deaths in chat (true/false).
# Can also be toggled at runtime from the web UI or with !toggleannounce in chat.
ANNOUNCE_DEATHS=true

# --- Clip Recording (Death Compilation) ---

# Save a short video clip around each death.
CLIP_ENABLED=true

# Seconds of footage to keep BEFORE the death.
CLIP_PRE_DEATH_SECONDS=3.0

# Seconds of footage to capture AFTER the death.
CLIP_POST_DEATH_SECONDS=2.0

# Playback FPS for saved clips.
CLIP_OUTPUT_FPS=10.0

# Directory to save clips (default: clips/ in project root).
# CLIP_OUTPUT_DIR=clips

# --- Web Server ---

# Port for the web UI.
WEB_PORT=4444

# Flask debug mode (auto-reload on code changes).
WEB_DEBUG=false

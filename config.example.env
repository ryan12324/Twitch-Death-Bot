# Twitch Bot Configuration
# Copy this file to .env and fill in your values

# --- Twitch Application (register at https://dev.twitch.tv/console) ---
# 1. Go to https://dev.twitch.tv/console and create a new application
# 2. Set the OAuth Redirect URL to: http://localhost:4343/oauth/callback
# 3. Copy the Client ID and Client Secret below
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Your bot account's numeric User ID
# To find this: visit https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
# or use the Twitch API: GET https://api.twitch.tv/helix/users?login=your_bot_username
TWITCH_BOT_ID=your_bot_user_id_here

# OAuth user token (access token) for the bot account
# After starting the bot, visit the OAuth URL printed in the logs to authorize.
# Once authorized, tokens are managed automatically. You can leave this blank
# after the first authorization.
TWITCH_TOKEN=

# The channel to monitor (without #)
TWITCH_CHANNEL=target_channel_name

# Target frames per second for stream capture. Higher = faster detection but more CPU.
# Options: 5 (low CPU), 10, 15 (recommended), 24, 30 (full rate)
TARGET_FPS=15

# Detection confidence threshold (0.0 - 1.0). Higher = fewer false positives.
DETECTION_THRESHOLD=0.80

# The game to detect deaths for. Options: elden_ring, dark_souls_3, sekiro, hollow_knight, celeste, generic
# Use "auto" to attempt automatic game detection, or comma-separate multiple: elden_ring,dark_souls_3
GAME_PROFILE=elden_ring

# Cooldown in seconds between death detections (prevents counting the same death twice)
DEATH_COOLDOWN=15

# Stream quality for capture (best, 1080p60, 1080p, 720p60, 720p, 480p, worst)
STREAM_QUALITY=720p

# --- Clip Recording (Death Compilation) ---
# Set to true to save a short video clip around each death
CLIP_ENABLED=true

# Seconds of footage to keep BEFORE the death
CLIP_PRE_DEATH_SECONDS=3.0

# Seconds of footage to capture AFTER the death
CLIP_POST_DEATH_SECONDS=2.0

# Playback FPS for saved clips (frames are duplicated to fill the timeline)
CLIP_OUTPUT_FPS=10.0

# Directory to save clips (default: clips/ in project root)
# CLIP_OUTPUT_DIR=clips

# --- Web Testing GUI ---
# Port for the web testing GUI (run with MODE=web or python web/app.py)
WEB_PORT=4444

# Set to true for Flask debug mode (auto-reload on code changes)
WEB_DEBUG=false
